# Claude: hakem, kullanıcı rolü, kırmızı takım ve Claude adayı için (yoksa kural tabanlı hakem çalışır)
ANTHROPIC_API_KEY=

# Borsa: hybrid = gerçek OKX fiyatları + sahte emir (varsayılan) | atk = gerçek OKX demo hesap | mock = çevrimdışı
EHLIYET_UPSTREAM=hybrid
# atk modunda ATK'ye geçirilen argümanlar — DEMO profilde kalın (~/.okx/config.toml)
EHLIYET_ATK_ARGS=--profile demo --modules market,spot,swap,account

# Yarışmacılara verilen MCP adresinin kökü (tünel ya da alan adı kullanıyorsanız)
EHLIYET_PUBLIC_URL=
EHLIYET_PORT=4747

# Güvenlik (isteğe bağlı)
EHLIYET_API_KEY=
EHLIYET_CORS_ORIGIN=*
EHLIYET_WEBHOOK_URL=
EHLIYET_WEBHOOK_SECRET=

# Bu tutarı aşan emirler borsaya hiç gönderilmez (USD)
EHLIYET_MAX_NOTIONAL=200
EHLIYET_MAX_CONCURRENT=3

# Modeller
EHLIYET_EXAMINER_MODEL=claude-sonnet-5-5
EHLIYET_CANDIDATE_MODEL=claude-sonnet-5-5

# Sigorta (simüle). Maruziyet: işlemlerin bu oranında sınavdaki türden bir durum yaşanır (varsayım).
EHLIYET_EXPOSURE=0.02
EHLIYET_POLICY_TASKS=100
EHLIYET_PREMIUM_LOAD=0.25
EHLIYET_POOL_SEED=10000

# Sınav temposu: her sınav en az bu kadar sürer (ms). 12 sınav × 3000 ≈ 36 sn. 0 = beklemesiz.
EHLIYET_PACE_MS=3000

# Avalanche kaydı: off | fuji | mainnet | local. Kurulum için: npm run avalanche:setup
EHLIYET_CHAIN=off
EHLIYET_CHAIN_RPC=
EHLIYET_CHAIN_KEY=
EHLIYET_CHAIN_CONTRACT=
